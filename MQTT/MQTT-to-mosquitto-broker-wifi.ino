const long interval = 1000;
unsigned long previousMillis = 0;

int count = 0;
X509List cert(root_ca);

void setup() {
  pinMode(LED_PIN, OUTPUT);
  Serial.begin(9600);
  while (!Serial) {
   delay(1) ; 
  }
  Serial.print("Attempting to connect to WPA SSID: ");
  Serial.println(ssid);
  while (WiFi.begin(ssid, pass) != WL_CONNECTED) {
     Serial.print(".");
    delay(5000);
  }

  Serial.println("You're connected to the network");
  Serial.println();
  Serial.println("IP address: ");
  Serial.println(WiFi.localIP());

  dht.begin();
  espclient.setInsecure();

  client.setServer(mqtt_server, mqtt_port);
  client.setCallback(callback);
}


void loop() {

  if (!client.connected()) {
    reconnect();
  }
  client.loop();
  delay(2000);
  //GET  temperature and Humidity values
  float temperature = readTemperature();
  float humidity = readHumidity();

  if(isnan(temperature) || isnan(humidity)){
    Serial.println(F("Failed to read from DHT sensor!"));
    return;
  }
  else {
      Serial.print(F("Humidity: "));
      Serial.print(humidity);
      Serial.print(F("%  Temperature: "));
      Serial.print(temperature);
      Serial.print(F("°C "));
      Serial.println();
      snprintf (msg, MSG_BUFFER_SIZE, " HUMIDITY: %f ; TEMPERATURE: %f °C ", humidity,temperature);
      snprintf (humid, MSG_BUFFER_SIZE, " HUMIDITY: %f %% ; ", humidity);
      snprintf (temp, MSG_BUFFER_SIZE, "TEMPERATURE: %f °C ",temperature);
      Serial.print("Publish message: ");
      Serial.println(msg);
      client.publish("outTopic", msg);
      client.publish("humidity", humid);
      client.publish("Temperature", temp);
  }
}

void callback(char* topic, byte* payload, unsigned int length) {
  Serial.print("Message arrived [");
  Serial.print(topic);
  Serial.print("] ");
  for (int i = 0; i < length; i++) {
    Serial.print((char)payload[i]);
  }
  Serial.println();
}

float readTemperature(){
  return dht.readTemperature();
}

float readHumidity(){
  return dht.readHumidity();
}

// For Initial and Auto reconnect
void reconnect() {
  // Loop until we're reconnected
  while (!client.connected()) {
    Serial.print("Attempting MQTT connection...");
    // Create a random client ID
    String clientId = "ESP8266Client-";
    clientId += String(random(0xffff), HEX);
    // Attempt to connect
    if (client.connect(clientId.c_str(),mqtt_username,mqtt_password)) {
      Serial.println("connected");
      // Once connected, publish an announcement...
      client.publish("outTopic", "hello world");
      // ... and resubscribe
      client.subscribe("inTopic");
    } else {
      Serial.print("failed, rc=");
      Serial.print(client.state());
      Serial.println(" try again in 5 seconds");
      // Wait 5 seconds before retrying
      delay(5000);
    }
  }
}
